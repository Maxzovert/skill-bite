{
  "expo": {
    "name": "SkillBite",
    "slug": "skillbite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/App_Logo.png",
    "splash": {
      "image": "./assets/App_Logo.png",
      "backgroundColor": "#FBF4EB",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillbite.app"
    },
    "android": {
      "package": "com.skillbite.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/App_Logo.png",
        "backgroundColor": "#FBF4EB"
      }
    },
    "scheme": "skillbite",
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
